{
    "name": "psychedcms/psychedcms-data-exchange",
    "description": "Metadata-driven content export/import for PsychedCMS",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "psychedcms/psychedcms-core": "^1.0 || @dev",
        "psychedcms/psychedcms-taxonomy": "^1.0 || @dev",
        "psychedcms/psychedcms-media": "^1.0 || @dev",
        "psychedcms/psychedcms-auth": "^1.0 || @dev",
        "doctrine/orm": "^3.0",
        "symfony/console": "^7.4",
        "symfony/dependency-injection": "^7.4",
        "symfony/security-core": "^7.4",
        "symfony/security-http": "^7.4",
        "symfony/uid": "^7.4",
        "gedmo/doctrine-extensions": "^3.0"
    },
    "suggest": {
        "league/flysystem": "Required for --with-media export/import"
    },
    "autoload": {
        "psr-4": {
            "PsychedCms\\DataExchange\\": "src/"
        }
    }
}
